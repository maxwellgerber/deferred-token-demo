{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deferred-token-response-idp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "DemoSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoSession"] }],
  "routes": [{ "pattern": "idp.deferred-token-response.dev", "custom_domain": true }],
  "vars": {
    "DEMO_JWT_SECRET": "dev-only-demo-secret-not-for-real-use"
  }
}
