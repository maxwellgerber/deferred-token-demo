{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deferred-token-response-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "deferred-token-response.dev", "custom_domain": true },
    { "pattern": "www.deferred-token-response.dev", "custom_domain": true }
  ]
}
